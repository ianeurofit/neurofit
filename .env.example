# Supabase (proyecto Neurofit IA)
# URL del proyecto (Dashboard > Project Settings > API Keys > Project URL).
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# Clave publicable/anon (Dashboard > Project Settings > API Keys > anon / publishable).
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Clave secreta / service_role (Dashboard > Project Settings > API Keys).
# Solo se usa en el servidor para crear, editar y eliminar usuarios.
SUPABASE_SERVICE_KEY=
